#!/bin/bash
# Atalho: a lógica fica no repositório (aulas/aula.sh), então novas aulas
# chegam com um simples "git pull", sem reconstruir a imagem.
# O "tr" remove finais de linha do Windows, caso o Git tenha convertido o arquivo.
tr -d '\r' < /opt/rangoja/aulas/aula.sh > /tmp/aula.sh
exec bash /tmp/aula.sh "$@"
